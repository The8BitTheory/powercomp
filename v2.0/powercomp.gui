  BEGIN Label lblD6      : Left = 41 : Top = 9 : Width = 3 : Caption = " 7" : END
  BEGIN TextField txtDisc6 : Left = 45 : Top = 9 : Width = 23 : MaxLength = 23 : OnChange = DiscChange : OnGotFocus = DiscFocus : END
  BEGIN Label lblStatus : Left = 1 : Top = 21 : Width = 76 : Caption = "" : END
END

BEGIN Form frmFile
  Caption     = "Load File"
  Width = 46 : Height = 20
  StartPos    = Center
  BorderStyle = Double
  Modal       = True
  Shadow      = True

  BEGIN ListBox lstFiles
    Left = 2 : Top = 1 : Width = 40 : Height = 12
    Capacity = 144
    OnDblClick = FileOK
  END
  BEGIN Label lblRen      : Left = 2  : Top = 14 : Caption = "New name:" : END
  BEGIN TextField txtRen  : Left = 12 : Top = 14 : Width = 17 : MaxLength = 16 : Filter = Filename : END
  BEGIN Button btnFLoad   : Left = 2  : Top = 16 : Width = 9  : Caption = "&Load"   : Default = True : OnClick = FileOK : END
  BEGIN Button btnFDel    : Left = 12 : Top = 16 : Width = 9  : Caption = "&Delete" : OnClick = FileDel : END
  BEGIN Button btnFRen    : Left = 22 : Top = 16 : Width = 9  : Caption = "&Rename" : OnClick = FileRen : END
  BEGIN Button btnFCancel : Left = 32 : Top = 16 : Width = 10 : Caption = "&Cancel" : Cancel = True : OnClick = FileCancel : END
END

BEGIN Form frmSave
  Caption     = "Save As"
  Width = 40 : Height = 8
  StartPos    = Center
  BorderStyle = Double
  Modal       = True
  Shadow      = True

  BEGIN Label lblSave      : Left = 2  : Top = 1 : Caption = "&File name:" : END
  BEGIN TextField txtSave  : Left = 14 : Top = 1 : Width = 17 : MaxLength = 16 : Filter = Filename : END
  BEGIN Button btnSOK      : Left = 6  : Top = 4 : Width = 10 : Caption = "OK"      : Default = True : OnClick = SaveOK : END
  BEGIN Button btnSCancel  : Left = 20 : Top = 4 : Width = 10 : Caption = "&Cancel" : Cancel = True  : OnClick = SaveCancel : END
END

BEGIN Form frmProg
  Caption     = "Please wait"
  Width = 46 : Height = 7
  StartPos    = Center
  BorderStyle = Double
  Shadow      = True

  BEGIN Label lblProg      : Left = 2 : Top = 1 : Width = 40 : Align = Center : Caption = "" : END
  BEGIN ProgressBar pbProg : Left = 2 : Top = 3 : Width = 40 : Max = 38 : END
END
