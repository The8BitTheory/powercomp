  BEGIN TextField txtScore6: Left = 23 : Top = 9 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank6   : Left = 34 : Top = 9 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId7     : Left = 1  : Top = 10 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName7 : Left = 5  : Top = 10 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore7: Left = 23 : Top = 10 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank7   : Left = 34 : Top = 10 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId8     : Left = 1  : Top = 11 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName8 : Left = 5  : Top = 11 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore8: Left = 23 : Top = 11 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank8   : Left = 34 : Top = 11 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId9     : Left = 1  : Top = 12 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName9 : Left = 5  : Top = 12 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore9: Left = 23 : Top = 12 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank9   : Left = 34 : Top = 12 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId10     : Left = 1  : Top = 13 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName10 : Left = 5  : Top = 13 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore10: Left = 23 : Top = 13 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank10   : Left = 34 : Top = 13 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId11     : Left = 1  : Top = 14 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName11 : Left = 5  : Top = 14 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore11: Left = 23 : Top = 14 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank11   : Left = 34 : Top = 14 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId12     : Left = 1  : Top = 15 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName12 : Left = 5  : Top = 15 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore12: Left = 23 : Top = 15 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank12   : Left = 34 : Top = 15 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId13     : Left = 1  : Top = 16 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName13 : Left = 5  : Top = 16 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore13: Left = 23 : Top = 16 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank13   : Left = 34 : Top = 16 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId14     : Left = 1  : Top = 17 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName14 : Left = 5  : Top = 17 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore14: Left = 23 : Top = 17 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank14   : Left = 34 : Top = 17 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId15     : Left = 1  : Top = 18 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName15 : Left = 5  : Top = 18 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore15: Left = 23 : Top = 18 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank15   : Left = 34 : Top = 18 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId16     : Left = 1  : Top = 19 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName16 : Left = 5  : Top = 19 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore16: Left = 23 : Top = 19 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank16   : Left = 34 : Top = 19 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId17     : Left = 1  : Top = 20 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName17 : Left = 5  : Top = 20 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore17: Left = 23 : Top = 20 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank17   : Left = 34 : Top = 20 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblD0      : Left = 41 : Top = 3 : Width = 3 : Caption = " 1" : END
  BEGIN TextField txtDisc0 : Left = 45 : Top = 3 : Width = 23 : MaxLength = 23 : OnChange = DiscChange : OnGotFocus = DiscFocus : END
  BEGIN Label lblD1      : Left = 41 : Top = 4 : Width = 3 : Caption = " 2" : END
  BEGIN TextField txtDisc1 : Left = 45 : Top = 4 : Width = 23 : MaxLength = 23 : OnChange = DiscChange : OnGotFocus = DiscFocus : END
  BEGIN Label lblD2      : Left = 41 : Top = 5 : Width = 3 : Caption = " 3" : END
