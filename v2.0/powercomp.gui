; powercomp.gui - Oberflaeche fuer die GUI-Fassung des Power Competition Manager (Textmodus)
; Vorlage: powercomp v1.3 (BASIC 7 + VDC-BASIC). Programm: powercomp.bas (BASIC, GUIT).
; Die Tabelle hat 18 Zeilen zu je 4 Controls (Nr, Spieler, Punkte, Rang) mit fortlaufenden
; Nummern: so fuellt GSETTEXT/GCAPTION c,18,A$(0),4 eine ganze Spalte auf einmal.
VERSION 1
MODE    TEXT
SCREEN  80, 25
THEME   "demo/vbdos.tht"

BEGIN Form frmMain
  Caption     = "Power Competition Manager V2.0"
  Left = 0 : Top = 0 : Width = 80 : Height = 25
  BorderStyle = Single

  BEGIN MenuBar
    BEGIN Menu mnuFile
      Caption = "&File"
      BEGIN Item mnuNew    : Caption = "&New"        : OnClick = MNew    : END
      BEGIN Item mnuLoad   : Caption = "&Load..."    : OnClick = MLoad   : END
      BEGIN Item mnuSave   : Caption = "&Save"       : OnClick = MSave   : END
      BEGIN Item mnuSaveAs : Caption = "Save &As..." : OnClick = MSaveAs : END
      BEGIN Item -         : END
      BEGIN Item mnuExit   : Caption = "E&xit"       : OnClick = MExit   : END
    END
    BEGIN Menu mnuOrder
      Caption = "&Order"
      BEGIN Item mnuById    : Caption = "By &ID"     : Shortcut = F1 : OnClick = OById    : END
      BEGIN Item mnuByName  : Caption = "By &Name"   : Shortcut = F3 : OnClick = OByName  : END
      BEGIN Item mnuByScore : Caption = "By &Score"  : Shortcut = F5 : OnClick = OByScore : END
      BEGIN Item mnuReverse : Caption = "&Reverse"   : Shortcut = F7 : OnClick = OReverse : END
    END
    BEGIN Menu mnuGen
      Caption = "&Generate"
      BEGIN Item mnuBoard : Caption = "Score&board" : OnClick = GBoard : END
      BEGIN Item mnuPfox  : Caption = "&Printfox"   : OnClick = GPfox  : END
      BEGIN Item mnuCsv   : Caption = "&CSV"        : OnClick = GCsv   : END
      BEGIN Item mnuAuto  : Caption = "&Automation" : OnClick = GAuto  : END
    END
  END

  BEGIN Label lblComp   : Left = 1  : Top = 0 : Caption = "Competition:" : END
  BEGIN TextField txtComp : Left = 14 : Top = 0 : Width = 40 : MaxLength = 40 : OnChange = CompChange : END
  BEGIN Label lblFileT  : Left = 56 : Top = 0 : Caption = "File:" : END
  BEGIN Label lblFile   : Left = 62 : Top = 0 : Width = 14 : Caption = "" : END
  BEGIN Label lblDirty  : Left = 77 : Top = 0 : Width = 1  : Caption = "" : END
  BEGIN Label lblHId    : Left = 1  : Top = 2 : Caption = "ID" : END
  BEGIN Label lblHName  : Left = 5  : Top = 2 : Caption = "Player" : END
  BEGIN Label lblHScore : Left = 23 : Top = 2 : Caption = "Score" : END
  BEGIN Label lblHRank  : Left = 34 : Top = 2 : Caption = "Rank" : END
  BEGIN Label lblHDisc  : Left = 42 : Top = 2 : Caption = "Disciplines (F4)" : END
  BEGIN Label lblId0     : Left = 1  : Top = 3 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName0 : Left = 5  : Top = 3 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore0: Left = 23 : Top = 3 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank0   : Left = 34 : Top = 3 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId1     : Left = 1  : Top = 4 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName1 : Left = 5  : Top = 4 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore1: Left = 23 : Top = 4 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank1   : Left = 34 : Top = 4 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId2     : Left = 1  : Top = 5 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName2 : Left = 5  : Top = 5 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore2: Left = 23 : Top = 5 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank2   : Left = 34 : Top = 5 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId3     : Left = 1  : Top = 6 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName3 : Left = 5  : Top = 6 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore3: Left = 23 : Top = 6 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank3   : Left = 34 : Top = 6 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId4     : Left = 1  : Top = 7 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN TextField txtName4 : Left = 5  : Top = 7 : Width = 16 : MaxLength = 16 : OnChange = CellChange : END
  BEGIN TextField txtScore4: Left = 23 : Top = 7 : Width = 10 : MaxLength = 10 : OnChange = CellChange : END
  BEGIN Label lblRank4   : Left = 34 : Top = 7 : Width = 3  : Align = Right : Caption = "" : END
  BEGIN Label lblId5     : Left = 1  : Top = 8 : Width = 3  : Align = Right : Caption = "" : END
